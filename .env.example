# ==============================================================================
# Chemify — Production Environment Configuration (Multi-App VPS Safe)
# Target Domain: chemify.solaymanbuilds.com
# ==============================================================================

# Isolated Docker Compose Project Name (prevents conflicts with other VPS apps)
PROJECT_NAME=chemify

# Public Domain Name for Nginx & Let's Encrypt SSL
DOMAIN=chemify.solaymanbuilds.com

# Administrator Email for Let's Encrypt SSL Renewal Alerts
EMAIL=elmouden00den@gmail.com

# Production Application Ports (Isolated high ports for multi-app VPS coexistence)
# Port 4326: Primary production application port
# Port 5467: Secondary / failover production port
PORT_PRIMARY=4326
PORT_SECONDARY=5467
