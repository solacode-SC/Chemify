# ==============================================================================
# Chemify — Production Environment Configuration
# Target Domain: chemify.solaymanbuilds.com
# ==============================================================================

# Public Domain Name for Nginx & Let's Encrypt SSL
DOMAIN=chemify.solaymanbuilds.com

# Administrator Email for Let's Encrypt SSL Renewal Alerts
EMAIL=admin@solaymanbuilds.com

# Production Application Ports
# Port 4326: Primary production application port
# Port 5467: Secondary / failover production port
PORT_PRIMARY=4326
PORT_SECONDARY=5467

# Runtime Environment
NODE_ENV=production

